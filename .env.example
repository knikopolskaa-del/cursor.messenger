# =============================================================================
# Локальная разработка
# =============================================================================
# При `npm run dev` запросы по умолчанию идут через прокси Vite → 127.0.0.1:8001
# (см. vite.config.js). Для прямых запросов к API с dev-сервера:
# VITE_API_DIRECT=1
# VITE_API_URL=http://127.0.0.1:8001
#
# Куда Vite проксирует API (если порт API не 8001):
# VITE_PROXY_TARGET=http://127.0.0.1:8001
#
# Порт uvicorn для `npm run api` / `npm run stack`:
# MESSENGER_API_PORT=8001
# PORT=8001

# =============================================================================
# Окружение и безопасность
# =============================================================================
# development | production — в production обязателен сильный AUTH_PEPPER и CORS_ORIGINS
APP_ENV=development

# Backend secrets (dev values are ok; in prod use long random strings)
AUTH_PEPPER=change_me

# 1 = открытая регистрация /auth/register (по умолчанию выкл. при APP_ENV=production)
PUBLIC_REGISTRATION_ENABLED=1

# Срок жизни сессии в секундах (минимум 300)
SESSION_TTL_SECONDS=604800

# Лимит попыток login/register/invite с одного IP в минуту
AUTH_RATE_LIMIT_PER_MINUTE=20

# Логи API: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# Production (фронт + CORS)
# =============================================================================
# Список origin фронта через запятую (обязательно при APP_ENV=production)
# CORS_ORIGINS=https://chat.example.com
#
# Опционально, если задан CORS_ORIGINS и нужен regex (иначе в dev — localhost)
# CORS_ORIGIN_REGEX=
#
# URL API при сборке фронта (`VITE_API_URL=https://chat.example.com npm run build`).
# На одном домене с nginx-прокси к API — укажите публичный origin сайта.
# VITE_API_URL=https://chat.example.com

# =============================================================================
# База данных
# =============================================================================
# По умолчанию SQLite: backend/messenger.db (относительно backend/)
# Локально можно не задавать.
#
# Явный путь (prod на VPS, данные в РФ на диске VM):
# MESSENGER_DATABASE_URL=sqlite:////var/lib/messenger/messenger.db
#
# PostgreSQL (если позже перенесёте с SQLite):
# MESSENGER_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/messenger

# =============================================================================
# Первый администратор (скрипт, не при каждом старте API)
# =============================================================================
# Запуск (из каталога backend, .env в корне репо подхватится):
#   cd backend && python3 -m app.bootstrap_admin
#
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change_me_or_long_random
# BOOTSTRAP_ADMIN_NAME=Главный админ

# =============================================================================
# Yandex Object Storage (S3-compatible) — private bucket + presigned URLs
# =============================================================================
YOS_ENDPOINT=https://storage.yandexcloud.net
YOS_REGION=ru-central1
YOS_BUCKET=change_me
YOS_ACCESS_KEY_ID=change_me
YOS_SECRET_ACCESS_KEY=change_me
YOS_PRESIGN_TTL_SECONDS=900
YOS_PREFIX=messenger/
