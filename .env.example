# При `npm run dev` запросы по умолчанию идут через прокси Vite → 127.0.0.1:8001
# (см. vite.config.js). Ниже — база для production-сборки и для dev с VITE_API_DIRECT=1.
# VITE_API_DIRECT=1
# VITE_API_URL=http://127.0.0.1:8001

# development | production — в production обязателен сильный AUTH_PEPPER
APP_ENV=development

# Backend secrets (dev values are ok; in prod use long random strings)
AUTH_PEPPER=change_me

# 1 = открытая регистрация /auth/register (по умолчанию выкл. при APP_ENV=production)
PUBLIC_REGISTRATION_ENABLED=1

# Срок жизни сессии в секундах (минимум 300)
SESSION_TTL_SECONDS=604800

# Лимит попыток login/register/invite с одного IP в минуту
AUTH_RATE_LIMIT_PER_MINUTE=20

# Production: список origin фронта через запятую (без regex localhost)
# CORS_ORIGINS=https://chat.example.com

# Yandex Object Storage (S3-compatible) — private bucket + presigned URLs
YOS_ENDPOINT=https://storage.yandexcloud.net
YOS_REGION=ru-central1
YOS_BUCKET=change_me
YOS_ACCESS_KEY_ID=change_me
YOS_SECRET_ACCESS_KEY=change_me
YOS_PRESIGN_TTL_SECONDS=900
YOS_PREFIX=messenger/
